# Көшіріп алыңыз: cp .env.example .env.local — және мәндерді толтырыңыз.
# NEXT_PUBLIC_ префиксі бар айнымалылар браузерге түседі. Қалғандары ТЕК серверде.

# Сайттың толық адресі (production: https://grantup.kz)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (2–3-кезең) — Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Құпия! RLS-ті айналып өтеді, тек серверде (админ әрекеттері, cron)
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic Claude API (7-кезең, AI-тьютор) — тек серверде ---
ANTHROPIC_API_KEY=

# --- Resend (10-кезең, email хабарламалар) ---
RESEND_API_KEY=
EMAIL_FROM="GrantUp <no-reply@grantup.kz>"
# Құрылғы сұраныстары туралы хабарлама баратын админ email-і (2-кезең)
ADMIN_NOTIFY_EMAIL=

# --- Web Push / VAPID (10-кезең) — `npx web-push generate-vapid-keys` ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@grantup.kz

# --- Cron (10-кезең) — Vercel Cron сұраныстарын тексеруге арналған кездейсоқ ұзын жол ---
CRON_SECRET=
